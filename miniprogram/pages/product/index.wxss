.gallery { height: 560rpx; }
.gimg { width: 100%; height: 560rpx; }
.name { font-size: 38rpx; font-weight: 600; }
.meta { margin: 12rpx 0; }
.price { font-size: 44rpx; font-weight: 600; }
.desc { white-space: pre-wrap; font-size: 30rpx; color: var(--text); }
.stepper { display: flex; align-items: center; }
.step { width: 72rpx; height: 64rpx; line-height: 64rpx; text-align: center; border: 1rpx solid var(--border); border-radius: 12rpx; font-size: 34rpx; }
.qty { width: 88rpx; text-align: center; font-size: 34rpx; font-weight: 600; }
.bottom-bar { align-items: center; }
.sub { flex: none; min-width: 160rpx; font-size: 36rpx; font-weight: 600; }
