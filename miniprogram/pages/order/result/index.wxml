<view class="container">
  <view class="card result">
    <block wx:if="{{state === 'ok'}}">
      <view class="icon ok">✓</view>
      <view class="title">预订成功</view>
      <view class="muted">{{order.summary}}</view>
      <view class="amount">{{totalText}}</view>
    </block>
    <block wx:elif="{{state === 'fail'}}">
      <view class="icon fail">!</view>
      <view class="title">{{order.statusText}}</view>
    </block>
    <block wx:else>
      <view class="icon">…</view>
      <view class="title">正在确认支付结果…</view>
    </block>
  </view>
</view>
<view class="bottom-bar" wx:if="{{state !== 'checking'}}">
  <button class="btn btn-secondary" bindtap="viewOrder">查看订单</button>
  <button class="btn btn-primary" bindtap="goBooking">继续订场</button>
</view>
