.result { text-align: center; padding: 64rpx 32rpx; }
.icon { width: 120rpx; height: 120rpx; margin: 0 auto 32rpx; border-radius: 50%; font-size: 64rpx; line-height: 120rpx; color: #FFFFFF; background: var(--disabled-text); }
.icon.ok { background: var(--primary); }
.icon.fail { background: var(--danger); }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.amount { font-size: 48rpx; font-weight: 600; margin-top: 24rpx; }
