.head .status { font-size: 38rpx; font-weight: 600; color: var(--primary); }
.head .amount { font-size: 38rpx; font-weight: 600; }
.item .top { align-items: flex-start; }
.item .title { font-size: 32rpx; font-weight: 600; flex: 1; }
.item .price { color: var(--text-2); font-size: 28rpx; margin-left: 16rpx; }
.state { margin-top: 12rpx; font-size: 28rpx; color: var(--primary); }
.code-hint { margin-top: 8rpx; font-size: 26rpx; color: var(--text-2); }
.refund-wrap { display: flex; justify-content: flex-end; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.refund { color: var(--danger); font-size: 30rpx; font-weight: 600; padding: 8rpx 0 8rpx 16rpx; }
.refund.off { color: var(--disabled-text); font-weight: 400; }
.refund-hint { color: var(--disabled-text); font-size: 26rpx; }
.mask { position: fixed; inset: 0; z-index: 200; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; }
.panel { width: 80%; background: #FFFFFF; border-radius: 24rpx; padding: 40rpx; text-align: center; }
.qr { width: 440rpx; height: 440rpx; margin: 24rpx auto 8rpx; display: block; }
.code { font-size: 56rpx; font-weight: 600; letter-spacing: 12rpx; margin-bottom: 8rpx; }
.close { margin-top: 32rpx; }
.stepper { display: flex; justify-content: center; align-items: center; margin: 32rpx 0 16rpx; }
.step { width: 80rpx; height: 72rpx; line-height: 72rpx; border: 1rpx solid var(--border); border-radius: 12rpx; font-size: 36rpx; }
.qty { width: 100rpx; font-size: 40rpx; font-weight: 600; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sheet-actions .btn { flex: 1; }
