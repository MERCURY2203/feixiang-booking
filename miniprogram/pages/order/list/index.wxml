<view class="tabs">
  <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.key === tab ? 'on' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
</view>
<view class="tabs-spacer"></view>

<view class="container">
  <view wx:if="{{needAgree}}" class="placeholder">
    <view>同意用户协议与隐私政策后可查看订单</view>
    <button class="btn btn-primary" style="margin-top: 24rpx" bindtap="askAgree">阅读并同意</button>
  </view>
  <view wx:elif="{{loaded && !list.length}}" class="placeholder">暂无订单</view>
  <block wx:for="{{list}}" wx:for-item="o" wx:for-index="index" wx:key="_id">
  <view wx:for="{{o.cards}}" wx:for-item="cd" wx:for-index="ci" wx:key="key" class="card" data-index="{{index}}" bindtap="open">
    <view class="row">
      <text class="muted">{{o.created}}</text>
      <text class="status {{o.status}}">{{o.statusText}}</text>
    </view>
    <view class="ol-lines">
      <view wx:for="{{cd.lines}}" wx:for-item="ln" wx:for-index="li" wx:key="li" class="ol-line {{ln.n ? 'has-n' : ''}}">
        <block wx:if="{{ln.kind === 'court'}}">
          <view class="ol-date">{{ln.date}}</view>
          <view wx:for="{{ln.rows}}" wx:for-item="r" wx:for-index="ri" wx:key="ri" class="ol-row"><text>{{r.time}}</text><text class="ol-court">{{r.court}}</text></view>
        </block>
        <block wx:else>
          <view class="ol-title">{{ln.title}}</view>
          <view wx:if="{{ln.n}}" class="ol-n">×{{ln.n}}</view>
        </block>
      </view>
    </view>
    <view class="row">
      <text wx:if="{{o.status === 'pending'}}" class="left">剩余 {{o.left}}</text>
      <text wx:else></text>
      <text class="amount">{{cd.totalText}}</text>
    </view>
    <view wx:if="{{o.status === 'pending' && ci === o.cards.length - 1}}" class="actions" catchtap="noop">
      <text wx:if="{{o.cards.length > 1}}" class="left">待付合计 {{o.totalText}}</text>
      <button class="btn btn-danger mini" data-index="{{index}}" catchtap="cancel">取消订单</button>
      <button class="btn btn-primary mini" data-index="{{index}}" catchtap="pay">去支付</button>
    </view>
  </view>
  </block>
</view>
<privacy-modal id="privacy" />
