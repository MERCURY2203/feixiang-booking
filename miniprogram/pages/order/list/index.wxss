.tabs { position: fixed; top: 0; left: 0; right: 0; z-index: 10; display: flex; background: #FFFFFF; border-bottom: 1rpx solid var(--border); }
.tab { flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; font-size: 30rpx; color: var(--text-2); }
.tab.on { color: var(--primary); font-weight: 600; border-bottom: 4rpx solid var(--primary); }
.tabs-spacer { height: 90rpx; }
.status { font-size: 28rpx; color: var(--text-2); }
.status.pending { color: var(--danger); }
.status.active { color: var(--primary); }
.summary { margin: 16rpx 0; font-size: 30rpx; }
.left { color: var(--danger); font-size: 28rpx; }
.amount { font-weight: 600; font-size: 34rpx; }
.actions { display: flex; gap: 20rpx; justify-content: flex-end; margin-top: 20rpx; }
.mini { height: 72rpx; font-size: 28rpx; width: 200rpx; }

.actions .left { margin-right: auto; align-self: center; }
