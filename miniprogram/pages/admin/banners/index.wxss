.tip { margin-bottom: 20rpx; }
.img { width: 100%; height: 260rpx; border-radius: 12rpx; background: var(--past); }
.meta { margin-top: 16rpx; align-items: flex-start; }
.state { font-weight: 600; color: var(--text-2); }
.state.on { color: var(--primary); }
.order { display: flex; gap: 12rpx; }
.arrow { width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center; border: 1rpx solid var(--border); border-radius: 12rpx; }
.ops { display: flex; justify-content: flex-end; gap: 40rpx; margin-top: 16rpx; color: var(--primary); font-size: 30rpx; }
.danger { color: var(--danger); }
