.tip { margin-bottom: 20rpx; }
.img { width: 100%; height: 388rpx; border-radius: 12rpx; background: var(--past); }
.meta { margin-top: 16rpx; align-items: flex-start; }
.state { font-weight: 600; color: var(--text-2); }
.state.on { color: var(--primary); }
.handle { width: 88rpx; height: 88rpx; line-height: 88rpx; text-align: center; font-size: 48rpx; color: var(--text-2); border: 1rpx solid var(--border); border-radius: 12rpx; }
.banner-card { margin-bottom: 12px; }
.dragging { border-color: var(--primary); box-shadow: 0 8rpx 24rpx rgba(43, 90, 174, 0.25); transform: scale(1.02); }
.ops { display: flex; justify-content: flex-end; gap: 40rpx; margin-top: 16rpx; color: var(--primary); font-size: 30rpx; }
.danger { color: var(--danger); }
