<admin-drawer current="banners" title="横幅管理" />
<view class="container">
  <view class="muted tip">最多 5 张同时显示，每张停留 10 秒；按住右边「≡」上下拖动调整顺序</view>
  <view wx:if="{{loaded && !list.length}}" class="placeholder">还没有横幅</view>
  <view wx:for="{{list}}" wx:key="_id" class="card banner-card {{dragging === index ? 'dragging' : ''}}">
    <image class="img" src="{{item.image}}" mode="aspectFill" data-index="{{index}}" bindtap="edit" />
    <view class="row meta">
      <view>
        <view class="state {{item.enabled ? 'on' : ''}}">{{item.state}}</view>
        <view class="muted">{{item.targetText}}</view>
        <view wx:if="{{item.mode === 'timed'}}" class="muted">{{item.startDate}} {{item.startTime}} 至 {{item.endDate}} {{item.endTime}}</view>
      </view>
      <view class="handle" data-index="{{index}}" catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragEnd">≡</view>
    </view>
    <view class="ops">
      <text data-index="{{index}}" bindtap="edit">编辑</text>
      <text data-index="{{index}}" bindtap="toggle">{{item.enabled ? '下架' : '上架'}}</text>
      <text class="danger" data-index="{{index}}" bindtap="remove">删除</text>
    </view>
  </view>
  <view class="bottom-spacer"></view>
</view>
<view class="bottom-bar"><button class="btn btn-primary" bindtap="edit">+ 新增横幅</button></view>
