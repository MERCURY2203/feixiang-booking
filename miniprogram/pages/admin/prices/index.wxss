.tabs { display: flex; background: #FFFFFF; border-bottom: 1rpx solid var(--border); }
.tab { flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; color: var(--text-2); }
.tab.on { color: var(--primary); font-weight: 600; border-bottom: 4rpx solid var(--primary); }
.link { color: var(--primary); }
.preview { padding: 20rpx; }
.line { padding: 16rpx 0; }
.strong { font-weight: 600; }
.label { font-size: 28rpx; color: var(--text-2); margin: 16rpx 0 10rpx; }
.field { height: 84rpx; line-height: 84rpx; border: 1rpx solid var(--border); border-radius: 12rpx; padding: 0 20rpx; }
.seg { display: flex; border: 1rpx solid var(--primary); border-radius: 12rpx; overflow: hidden; margin-bottom: 16rpx; }
.seg-item { flex: 1; text-align: center; height: 76rpx; line-height: 76rpx; color: var(--primary); }
.seg-item.on { background: var(--primary); color: #FFFFFF; font-weight: 600; }
.note { margin-top: 16rpx; }
.ops { display: flex; justify-content: flex-end; gap: 40rpx; color: var(--primary); margin-top: 12rpx; }
.danger { color: var(--danger); }
.expired-toggle { text-align: center; color: var(--text-2); padding: 20rpx 0; }
.expired { opacity: 0.6; }
