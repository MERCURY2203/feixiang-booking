.tabs { display: flex; background: #FFFFFF; border-bottom: 1rpx solid var(--border); }
.tab { flex: 1; text-align: center; height: 88rpx; line-height: 88rpx; color: var(--text-2); }
.tab.on { color: var(--primary); font-weight: 600; border-bottom: 4rpx solid var(--primary); }
.big { font-size: 40rpx; font-weight: 600; margin-top: 8rpx; }
.field { margin-top: 16rpx; height: 84rpx; line-height: 84rpx; border: 1rpx solid var(--border); border-radius: 12rpx; padding: 0 20rpx; }
.seg { display: flex; border: 1rpx solid var(--primary); border-radius: 12rpx; overflow: hidden; margin-top: 16rpx; }
.seg-item { flex: 1; text-align: center; height: 76rpx; line-height: 76rpx; color: var(--primary); }
.seg-item.on { background: var(--primary); color: #FFFFFF; font-weight: 600; }
.note { margin-top: 16rpx; }
.danger { color: var(--danger); }
.closed { margin-top: 16rpx; }
