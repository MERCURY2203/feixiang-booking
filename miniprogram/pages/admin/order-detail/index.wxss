.warn { background: #FDEDED; color: var(--danger); border-radius: 16rpx; padding: 20rpx 28rpx; margin-bottom: 24rpx; }
.phone { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); }
.link { color: var(--primary); font-weight: 600; }
.item.picked { border-color: var(--primary); background: var(--primary-light); }
.top { justify-content: flex-start; gap: 16rpx; }
.title { flex: 1; font-weight: 600; }
.check { width: 44rpx; height: 44rpx; border: 2rpx solid var(--text-2); border-radius: 8rpx; text-align: center; line-height: 44rpx; color: #FFFFFF; font-size: 28rpx; }
.check.on { background: var(--primary); border-color: var(--primary); }
.state { color: var(--primary); font-size: 28rpx; margin-top: 8rpx; }
.foot { margin-top: 12rpx; }
.refund { color: var(--danger); font-weight: 600; }
.refund.off { color: var(--disabled-text); font-weight: 400; }
.log { padding: 12rpx 0; font-size: 28rpx; }
.mask { position: fixed; inset: 0; z-index: 200; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; }
.panel { width: 84%; background: #FFFFFF; border-radius: 24rpx; padding: 40rpx; }
.label { margin-top: 24rpx; font-size: 28rpx; color: var(--text-2); }
.stepper { display: flex; align-items: center; margin-top: 12rpx; }
.step { width: 80rpx; height: 70rpx; line-height: 70rpx; text-align: center; border: 1rpx solid var(--border); border-radius: 12rpx; font-size: 36rpx; }
.qty { width: 100rpx; text-align: center; font-size: 40rpx; font-weight: 600; }
.amount-input { margin-top: 12rpx; height: 88rpx; border: 1rpx solid var(--border); border-radius: 16rpx; padding: 0 24rpx; font-size: 40rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.actions .btn { flex: 1; }
