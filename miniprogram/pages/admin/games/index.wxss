.tabs { display: flex; background: #FFFFFF; border-bottom: 1rpx solid var(--border); }
.tab { flex: 1; text-align: center; padding: 20rpx 0 16rpx; color: var(--text-2); border-bottom: 6rpx solid transparent; }
.tab.on { color: var(--primary); font-weight: 600; border-bottom-color: var(--primary); }
.st { font-size: 26rpx; color: var(--primary); flex-shrink: 0; margin-left: 16rpx; }
