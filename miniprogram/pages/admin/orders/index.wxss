.search { display: flex; gap: 16rpx; }
.kw { flex: 1; height: 88rpx; background: #FFFFFF; border: 1rpx solid var(--border); border-radius: 16rpx; padding: 0 24rpx; }
.sbtn { width: 160rpx; height: 88rpx; }
.filters { display: flex; gap: 16rpx; margin: 20rpx 0; }
.chip { padding: 12rpx 28rpx; background: #FFFFFF; border: 1rpx solid var(--border); border-radius: 40rpx; font-size: 28rpx; }
.chip.clear { color: var(--text-2); }
.tabs { display: flex; background: #FFFFFF; border-radius: 16rpx; margin-bottom: 24rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; height: 80rpx; line-height: 80rpx; font-size: 28rpx; color: var(--text-2); }
.tab.on { background: var(--primary); color: #FFFFFF; font-weight: 600; }
.status { color: var(--primary); font-size: 28rpx; }
.summary { margin: 12rpx 0; }
.amount { font-weight: 600; }
