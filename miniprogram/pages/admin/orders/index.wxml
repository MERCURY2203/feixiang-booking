<admin-drawer current="orders" title="订单管理" />
<view class="container">
  <view class="search">
    <input class="kw" placeholder="手机号后 4 位或订单号" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="search" />
    <button class="btn btn-primary sbtn" bindtap="search">搜索</button>
  </view>
  <view class="filters">
    <picker mode="date" value="{{date}}" bindchange="pickDate">
      <view class="chip">{{date || '选择日期'}}</view>
    </picker>
    <view wx:if="{{date}}" class="chip clear" bindtap="clearDate">清除日期</view>
  </view>
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.key === tab ? 'on' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
  </view>

  <view wx:if="{{loaded && !list.length}}" class="placeholder">没有找到订单</view>
  <view wx:for="{{list}}" wx:key="_id" class="card" data-index="{{index}}" bindtap="open">
    <view class="row">
      <text class="muted">{{item.created}} · {{item.phone}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="ol-lines">
      <view wx:for="{{item.lines}}" wx:for-item="ln" wx:for-index="li" wx:key="li" class="ol-line {{ln.n ? 'has-n' : ''}}">
        <block wx:if="{{ln.kind === 'court'}}">
          <view class="ol-date">{{ln.date}}</view>
          <view wx:for="{{ln.rows}}" wx:for-item="r" wx:for-index="ri" wx:key="ri" class="ol-row"><text>{{r.time}}</text><text class="ol-court">{{r.court}}</text></view>
        </block>
        <block wx:else>
          <view class="ol-title">{{ln.title}}</view>
          <view wx:if="{{ln.n}}" class="ol-n">×{{ln.n}}</view>
        </block>
      </view>
    </view>
    <view class="row"><text class="muted">{{item._id}}</text><text class="amount">{{item.totalText}}</text></view>
  </view>
</view>
