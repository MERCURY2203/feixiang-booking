<admin-drawer current="orders" title="订单管理" />
<view class="container">
  <view class="search">
    <input class="kw" placeholder="手机号后 4 位或订单号" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="search" />
    <button class="btn btn-primary sbtn" bindtap="search">搜索</button>
  </view>
  <view class="filters">
    <picker mode="date" value="{{date}}" bindchange="pickDate">
      <view class="chip">{{date || '选择日期'}}</view>
    </picker>
    <view wx:if="{{date}}" class="chip clear" bindtap="clearDate">清除日期</view>
  </view>
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{item.key === tab ? 'on' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.name}}</view>
  </view>

  <view wx:if="{{loaded && !list.length}}" class="placeholder">没有找到订单</view>
  <block wx:for="{{list}}" wx:for-item="o" wx:for-index="index" wx:key="_id">
  <view wx:for="{{o.cards}}" wx:for-item="cd" wx:for-index="ci" wx:key="key" class="card" data-index="{{index}}" bindtap="open">
    <view class="row">
      <text class="muted">{{o.created}} · {{o.phone}}</text>
      <text class="status">{{o.statusText}}</text>
    </view>
    <view class="ol-lines">
      <view wx:for="{{cd.lines}}" wx:for-item="ln" wx:for-index="li" wx:key="li" class="ol-line {{ln.n ? 'has-n' : ''}}">
        <view wx:if="{{ln.kind === 'courtRow'}}" class="ol-row"><text>{{ln.date}} {{ln.time}}</text><text class="ol-court">{{ln.court}}</text></view>
        <block wx:else>
          <view class="ol-title">{{ln.title}}</view>
          <view wx:if="{{ln.n}}" class="ol-n">×{{ln.n}}</view>
        </block>
      </view>
    </view>
    <view class="row"><text class="muted">{{o._id}}</text><text class="amount">{{cd.totalText}}</text></view>
  </view>
  </block>
</view>
