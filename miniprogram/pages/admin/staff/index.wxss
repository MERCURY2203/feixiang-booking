.link { color: var(--primary); font-size: 30rpx; }
.actions { display: flex; justify-content: flex-end; margin-top: 12rpx; }
.remove { color: var(--danger); font-size: 30rpx; padding: 8rpx 0 0 24rpx; }
.mask { position: fixed; inset: 0; z-index: 200; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; }
.panel { width: 80%; background: #FFFFFF; border-radius: 24rpx; padding: 40rpx; text-align: center; }
.qr { width: 420rpx; height: 420rpx; margin: 32rpx auto 16rpx; display: block; }
.center { margin-bottom: 32rpx; }

.role { font-size: 22rpx; font-weight: 400; padding: 2rpx 12rpx; border-radius: 8rpx; margin-left: 8rpx; background: var(--primary-light); color: var(--primary); }
.role.host { background: #FFF4E5; color: #B25E00; }
