/* 全局樣式（技術方案書「畫面風格」）：只用一個 logo 藍，其餘黑白灰，提醒用紅 */
page {
  --primary: #2B5AAE;
  --primary-light: #E8EFFA;
  --text: #1A1A1A;
  --text-2: #666666;
  --disabled-bg: #D9D9D9;
  --disabled-text: #8C8C8C;
  --past: #F2F2F2;
  --danger: #E54545;
  --border: #E6E6E6;
  background: #F7F8FA;
  color: var(--text);
  font-size: 32rpx; /* 比一般小程序大一號，照顧老人家 */
  line-height: 1.6;
}

.container { padding: 24rpx 32rpx; }

/* 卡片：同類卡片樣式完全一致（G9） */
.card {
  background: #FFFFFF;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.card-title { font-size: 34rpx; font-weight: 600; }
.muted { color: var(--text-2); font-size: 28rpx; }

/* 按鈕：主要藍底白字、次要藍框白底、危險紅框紅字 */
.btn {
  display: flex; align-items: center; justify-content: center;
  height: 92rpx; border-radius: 16rpx;
  font-size: 32rpx; font-weight: 600;
  margin: 0; padding: 0 32rpx;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #FFFFFF; }
.btn-secondary { background: #FFFFFF; color: var(--primary); border: 2rpx solid var(--primary); }
.btn-danger { background: #FFFFFF; color: var(--danger); border: 2rpx solid var(--danger); }
.btn[disabled] { background: var(--disabled-bg) !important; color: var(--disabled-text) !important; border-color: var(--disabled-bg) !important; }

/* 底部固定欄：新增按鈕固定在底部（G9） */
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF; border-top: 1rpx solid var(--border);
}
.bottom-bar .btn { flex: 1; }
.bottom-spacer { height: calc(140rpx + env(safe-area-inset-bottom)); }

.row { display: flex; align-items: center; justify-content: space-between; }
.placeholder { text-align: center; color: var(--text-2); padding: 120rpx 0; }

/* 訂單卡片明細：同類項合併，每條信息單獨一行，右上角圓圈寫乘幾 */
.ol-line { position: relative; padding: 16rpx 96rpx 16rpx 0; border-bottom: 1rpx solid var(--border); }
.ol-line:last-child { border-bottom: none; }
.ol-title { font-size: 30rpx; font-weight: 600; }
.ol-sub { font-size: 28rpx; color: var(--text-2); margin-top: 6rpx; }
.ol-n { position: absolute; top: 14rpx; right: 0; min-width: 64rpx; height: 64rpx; padding: 0 8rpx; box-sizing: border-box; border: 3rpx solid var(--primary); border-radius: 50%; color: var(--primary); font-size: 28rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; }
