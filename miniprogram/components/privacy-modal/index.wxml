<view wx:if="{{show}}" class="mask" catchtouchmove="noop">
  <view class="panel">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />

    <view class="title">欢迎使用飞翔球馆</view>
    <view class="desc">为了给你提供订场、购买活动等服务，请阅读并同意以下协议。不同意也可以先随便看看。</view>
    <view class="check" bindtap="toggle">
      <view class="box {{checked ? 'on' : ''}}">{{checked ? '✓' : ''}}</view>
      <view>我已阅读并同意<text class="link" catchtap="openDoc" data-type="agreement">《用户协议》</text>和<text class="link" catchtap="openDoc" data-type="privacy">《隐私政策》</text></view>
    </view>
    <button class="btn btn-primary full" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgree">同意并继续</button>
    <view class="plain" bindtap="onDisagree">不同意，先随便看看</view>
  </view>
</view>
