@import '../../app.wxss';

.mask {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(0, 0, 0, 0.5);
  display: flex; align-items: flex-end;
}
.panel {
  width: 100%; background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.logo { width: 100%; height: 160rpx; margin-bottom: 16rpx; }
.title { font-size: 38rpx; font-weight: 600; margin-bottom: 16rpx; }
.desc { color: var(--text-2); font-size: 30rpx; margin-bottom: 32rpx; }
.check { display: flex; align-items: flex-start; gap: 16rpx; font-size: 30rpx; margin-bottom: 40rpx; }
.box {
  flex: none; width: 40rpx; height: 40rpx; margin-top: 4rpx;
  border: 2rpx solid var(--text-2); border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #FFFFFF;
}
.box.on { background: var(--primary); border-color: var(--primary); }
.link { color: var(--primary); }
.full { width: 100%; }
.plain { text-align: center; color: var(--text-2); padding: 28rpx 0 0; font-size: 30rpx; }
