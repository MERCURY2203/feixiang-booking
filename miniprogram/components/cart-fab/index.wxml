<view wx:if="{{!collapsed}}" class="fab" bindtap="go" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="icon">购物车</view>
  <view wx:if="{{count > 0}}" class="badge">{{count > 99 ? '99+' : count}}</view>
  <view class="hide" catchtap="collapse">›</view>
</view>
<view wx:else class="tab" bindtap="expand" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="tab-arrow">‹</view>
  <view class="tab-text">购物车</view>
  <view wx:if="{{count > 0}}" class="tab-badge">{{count > 99 ? '99+' : count}}</view>
</view>
