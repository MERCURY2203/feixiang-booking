.fab { position: fixed; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); z-index: 90; width: 128rpx; height: 128rpx; border-radius: 50%; background: #2B5AAE; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(43, 90, 174, 0.35); }
.icon { color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 44rpx; height: 44rpx; padding: 0 10rpx; box-sizing: border-box; border-radius: 22rpx; background: #E54545; color: #FFFFFF; font-size: 24rpx; line-height: 44rpx; text-align: center; }
