.fab { position: fixed; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); z-index: 90; width: 128rpx; height: 128rpx; border-radius: 50%; background: #2B5AAE; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(43, 90, 174, 0.35); }
.icon { color: #FFFFFF; font-size: 26rpx; font-weight: 600; }
.badge { position: absolute; top: -6rpx; right: -6rpx; min-width: 44rpx; height: 44rpx; padding: 0 10rpx; box-sizing: border-box; border-radius: 22rpx; background: #E54545; color: #FFFFFF; font-size: 24rpx; line-height: 44rpx; text-align: center; }
/* 左上角的小箭頭：點一下把浮窗收到右邊 */
.hide { position: absolute; top: -10rpx; left: -10rpx; width: 48rpx; height: 48rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: #FFFFFF; color: #2B5AAE; font-size: 32rpx; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2); }

/* 收起後：貼著右邊緣的半圓小標籤 */
.tab { position: fixed; right: 0; bottom: calc(40rpx + env(safe-area-inset-bottom)); z-index: 90; width: 72rpx; height: 128rpx; border-radius: 64rpx 0 0 64rpx; background: #2B5AAE; color: #FFFFFF; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(43, 90, 174, 0.35); }
.tab-arrow { font-size: 30rpx; line-height: 30rpx; font-weight: 600; }
.tab-text { font-size: 22rpx; line-height: 28rpx; margin-top: 4rpx; width: 26rpx; text-align: center; }
.tab-badge { position: absolute; top: -12rpx; left: -4rpx; min-width: 40rpx; height: 40rpx; padding: 0 8rpx; box-sizing: border-box; border-radius: 20rpx; background: #E54545; color: #FFFFFF; font-size: 22rpx; line-height: 40rpx; text-align: center; }
