<view class="topbar">
  <view class="menu-btn" bindtap="toggle">☰</view>
  <view class="topbar-title">{{title}}</view>
</view>
<view class="topbar-spacer"></view>

<view wx:if="{{open}}" class="mask" bindtap="toggle" catchtouchmove="noop">
  <view class="drawer" catchtap="noop">
    <view class="drawer-head">飞翔球馆 · 管理后台</view>
    <view wx:for="{{items}}" wx:key="key" class="drawer-item {{item.key === current ? 'on' : ''}}" data-index="{{index}}" bindtap="go">{{item.title}}</view>
    <view class="drawer-item back" bindtap="backToCustomer">返回客人模式</view>
  </view>
</view>
