.wrap { background: #FFFFFF; }
/* 右邊留一點空白，最後一列不貼邊 */
.grid { display: inline-block; min-width: 100%; padding-right: 24rpx; box-sizing: border-box; }
.row { display: flex; }
.head { position: sticky; top: 0; z-index: 3; }
.corner, .hcell, .tcell, .cell { flex: none; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.corner { position: sticky; left: 0; z-index: 4; width: 120rpx; height: 72rpx; background: #FFFFFF; color: #666666; border-bottom: 1rpx solid #E6E6E6; }
.hcell { width: 150rpx; height: 72rpx; background: #FFFFFF; color: #1A1A1A; font-weight: 600; border-bottom: 1rpx solid #E6E6E6; }
.tcell { position: sticky; left: 0; z-index: 2; width: 120rpx; height: 92rpx; background: #FFFFFF; color: #666666; border-right: 1rpx solid #E6E6E6; }
/* 可訂：白底、綠色描邊、綠色加粗價格（澄清 M1；綠色是 logo 綠 #A8EC68 加深，白底上看得清） */
.cell { width: 142rpx; height: 80rpx; margin: 6rpx 4rpx; border-radius: 12rpx; border: 3rpx solid #4E8C17; background: #FFFFFF; color: #4E8C17; font-weight: 600; }
.cell.sel { background: #2B5AAE; border-color: #2B5AAE; color: #FFFFFF; }
.cell.taken { background: #F2F2F2; border-color: #F2F2F2; color: transparent; }
/* 所有訂不了的格子（已被訂、老闆鎖場、時間已過）：同樣的淺灰底、同樣的淡灰叉 */
.cell.taken, .cell.past, .cell.locked { position: relative; }
.cell.taken::before, .cell.taken::after, .cell.past::before, .cell.past::after { content: ''; position: absolute; left: 50%; top: 50%; width: 48rpx; height: 4rpx; border-radius: 2rpx; background: #C8C8C8; }
.cell.taken::before, .cell.past::before { transform: translate(-50%, -50%) rotate(45deg); }
.cell.taken::after, .cell.past::after { transform: translate(-50%, -50%) rotate(-45deg); }
.cell.past { background: #F2F2F2; border-color: #F2F2F2; color: transparent; }
.cell.locked { background: #F2F2F2; border-color: #F2F2F2; color: #8C8C8C; font-weight: 400; }
.cell.booked { background: #E8EFFA; border-color: #E8EFFA; color: #2B5AAE; font-weight: 400; }
.cell.special { background: #E8EFFA; border-color: #2B5AAE; color: #2B5AAE; font-weight: 600; }
/* 我訂的場地：淺藍底＋藍框＋「我的」；我的待支付：同樣的藍框虛線＋中間一個沙漏，避免誤以為被別人搶先訂了 */
.cell.mine { background: #D9E6FB; border: 2rpx solid #2B5AAE; color: #2B5AAE; font-weight: 600; }
.cell.mypending { background: #EEF3FC; border: 2rpx dashed #2B5AAE; color: #2B5AAE; font-size: 40rpx; }
.tail { height: 40rpx; }
